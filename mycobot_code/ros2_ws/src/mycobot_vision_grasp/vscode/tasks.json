{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon build (arm)",
      "type": "shell",
      "command": "source /opt/ros/jazzy/setup.bash && colcon build --symlink-install --packages-select cobot_interfaces mycobot_vision_grasp",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "run arm task (sim)",
      "type": "shell",
      "command": "source install/setup.bash && ros2 launch mycobot_vision_grasp arm_task.launch.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": []
    }
  ]
}