{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug arm_task_node",
      "type": "debugpy",
      "request": "launch",
      "module": "mycobot_vision_grasp.grasp_node",
      "args": [
        "--ros-args",
        "-r",
        "__node:=arm_task",
        "--params-file",
        "${workspaceFolder}/src/mycobot_vision_grasp/config/arm_task.yaml",
        "-p",
        "use_sim_time:=true"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}