<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_vision_grasp</name>
  <version>0.1.0</version>
  <description>myCobot arm task: locate blocks with a depth camera, pick, hand off to vehicle, place (ROS 2 Jazzy)</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>cobot_interfaces</exec_depend>
  <exec_depend>team6_vision</exec_depend>  <!-- official real-robot vision -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>mycobot_driver</exec_depend>      <!-- kinematics (built-in IK) -->
  <exec_depend>realsense2_camera</exec_depend>   <!-- D435 driver on the laptop / NUC -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <!-- simulation only (not required on the real robot): ros_gz_bridge, ros_gz_sim, moveit_msgs -->
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
