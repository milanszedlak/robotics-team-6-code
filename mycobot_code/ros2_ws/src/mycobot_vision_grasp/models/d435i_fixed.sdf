<?xml version="1.0"?>
<!-- Fixed D435i for Gazebo (the launch file places it according to config/camera_pose.yaml) -->
<sdf version="1.9">
  <model name="d435i_fixed">
    <static>true</static>
    <link name="camera_link">
      <visual name="body">
        <pose>-0.0125 0 0 0 0 0</pose>
        <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <sensor name="d435i" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>d435i</topic>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>3.0</far></clip>
          <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
